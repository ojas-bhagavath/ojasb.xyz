:root {
  --base: #fbf1c7;
  --text: #282828;
  --red: #cc241d;
  --blue: #b16286;
}

.dark-mode {
  --base: #282828;
  --text: #fbf1c7;
  --red: #cc241d;
  --blue: #b16286;
}

* {
  box-sizing: border-box;
}

@font-face {
  font-family: "Source_Serif_4";
  src: url("fonts/SourceSerif4/SourceSerif4Roman-Regular.eot");
  src: url("fonts/SourceSerif4/SourceSerif4Roman-Regular.eot?#iefix") format("embedded-opentype"), url("fonts/SourceSerif4/SourceSerif4Roman-Regular.woff2") format("woff2"), url("fonts/SourceSerif4/SourceSerif4Roman-Regular.woff") format("woff"), url("fonts/SourceSerif4/SourceSerif4Roman-Regular.ttf") format("truetype"), url("fonts/SourceSerif4/SourceSerif4Roman-Regular.svg#SourceSerif4Roman-Regular") format("svg");
  font-weight: normal;
  font-style: normal;
}

@font-face {
  font-family: "Deutsche_Zierschrift";
  src: url("/fonts/DeutscheZierschrift/DeutscheZierschrift.eot");
  src: url("/fonts/DeutscheZierschrift/DeutscheZierschrift.eot?#iefix") format("embedded-opentype"), url("/fonts/DeutscheZierschrift/DeutscheZierschrift.woff2") format("woff2"), url("/fonts/DeutscheZierschrift/DeutscheZierschrift.woff") format("woff"), url("/fonts/DeutscheZierschrift/DeutscheZierschrift.ttf") format("truetype"), url("/fonts/DeutscheZierschrift/DeutscheZierschrift.svg#DeutscheZierschrift") format("svg");
  font-weight: normal;
  font-style: normal;
}

html body {
  color: var(--text);
  background-color: var(--base);
  font-family: "Source_Serif_4";
}

html body h1 {
  border-bottom: dotted;
  border-width: 1px;
  border-radius: 1px;
}

html body h1 a,
html body h2 a {
  text-decoration: none;
  color: inherit;
}

html body header nav {
  width: 95%;
  margin-left: auto;
  margin-right: auto;
}

html body header nav ul {
  list-style: none;
  display: flex;
  height: 60px;
  margin-top: 0px;
  padding: 0px;
}

html body header nav ul li {
  display: flex;
  height: 100%;
}

html body header nav ul li a {
  display: flex;
  text-decoration: none;
  color: var(--text);
}

html body header nav ul li svg {
  display: flex;
  fill: var(--text);
  object-fit: contain;
}

html body header nav ul .home-li {
  margin-right: auto;
  padding: 0.5em 2em;
}

html body header nav ul .home-li a {
  font-family: "Deutsche_Zierschrift";
  font-size: 80px;
}

html body header nav ul .active-page,
html body header nav ul .passive-page {
  padding-left: 2em;
  padding-right: 2em;
  align-items: center;
}

html body header nav ul .active-page:hover,
html body header nav ul .passive-page:hover {
  border-bottom: var(--blue) solid 2px;
}

html body header nav ul .active-page:hover a,
html body header nav ul .passive-page:hover a {
  color: var(--blue);
}

html body header nav ul .active-page {
  border-bottom: var(--red) solid 2px;
}

html body header nav ul .active-page a {
  color: var(--red);
}

html body header nav ul .theme-switcher-li {
  margin-left: auto;
  padding: 1em 2em;
}

html body main {
  padding-top: 2em;
  width: calc(min(975px, 90%));
  margin: auto;
  font-family: "source_serif_4";
  font-size: 18px;
}

html body main .quotefigure {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

html body main .quotefigure::before {
  content: open-quote;
  font-weight: bold;
  font-size: 50px;
  align-self: start;
}

html body main .quotefigure::after {
  content: close-quote;
  font-weight: bold;
  font-size: 50px;
  align-self: end;
}

html body main .quotefigure .quotebox {
  flex: 1;
}

html body main .quotefigure .quotebox .sectionquotes {
  font-weight: 400;
  font-style: italic;
}

html body main .quotefigure .quotebox .sectionquotes .quotecite {
  text-align: right;
}

/*# sourceMappingURL=style.css.map */