{
    "plugins": ["prettier-plugin-go-template", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "go-template",
                "goTemplateBracketSpacing": true,
                "bracketSameLine": true
            }
        },
        {
            "files": ["*.js", "*.ts"],
            "options": {
                "useTabs": true,
                "printWidth": 120,
                "singleQuote": true
            }
        }
    ]
}
